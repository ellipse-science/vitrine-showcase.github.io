/node_modules

# Next.js
/.next/
/out/
next-env.d.ts

# TypeScript
*.tsbuildinfo

# Vercel (in case anyone runs `vercel` locally)
.vercel

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store

# Python (scripts/generate_art.py, fetch helpers)
__pycache__/
*.pyc

# Editor
*.swp
*.swo
.venv

