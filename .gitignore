# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules

# Next.js
/.next/
/out/
next-env.d.ts

# TypeScript
*.tsbuildinfo

# Vercel (in case anyone runs `vercel` locally)
.vercel

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store

# Python (scripts/generate_art.py, fetch helpers)
__pycache__/
*.pyc

# Editor
*.swp
*.swo
.venv

# Local build artifacts and tooling
/build/
/next-site/
yarn.lock

# Worktrees git imbriqués (git worktree add _worktrees/<nom>) — copies locales
# du projet : jamais commitées, et exclues du type-check via tsconfig.json
_worktrees/

# Agent config: share skills/hooks/settings, keep personal settings local
/.claude/settings.local.json

# Jeu de données FICTIF du module Partis — régénérable par
# `node scripts/make_parties_fixtures.mjs`. Volontairement NON versionné :
# aucune donnée inventée ne doit pouvoir être confondue avec la donnée réelle.
/fixtures/

# CSV intermédiaires de scripts/load_pg.mjs
.pgload/

# Illustration de la Une des unes : rapatriée au build par scripts/fetch_art.mjs
# (raffineur vitrine-art -> R2 -> API), plus jamais commitée.
/public/data/generated-art/latest.*
/public/data/hero-selection.json

# Pochettes des partis (bac du jour + discothèque) : même circuit, rapatriées au
# build par scripts/fetch_art.mjs. Le dossier peut aussi contenir les fausses
# pochettes de scripts/make_pochettes_fixtures.mjs — raison de plus pour qu'il
# ne parte jamais dans un commit.
/public/data/generated-art/partis/
/public/data/partis-selection.json
